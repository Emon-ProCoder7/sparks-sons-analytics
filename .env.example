# ---- Portal (set these in Vercel) ----
PORTAL_PASSCODE=            # admin login
PORTAL_VIEW_PASSCODE=       # optional read-only login to hand the client
PORTAL_SESSION_SECRET=      # long random string, signs the session cookie
N8N_WEBHOOK_BASE=https://your-n8n.example.com/webhook
N8N_SHARED_SECRET=          # generated by n8n/build.mjs; must match the "Sparks · portal secret" credential

# ---- n8n build script only (never needed on Vercel) ----
N8N_API_URL=https://your-n8n.example.com
N8N_API_KEY=
N8N_INTERNAL_API_URL=http://127.0.0.1:5678   # how n8n reaches its own API from inside its container
WORKER_SECRET=              # generated; set the same value on the Maps worker
WORKER_URL=                 # public URL of the Maps worker once deployed
